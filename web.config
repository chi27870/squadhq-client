<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site whose physical path is ONLY the SquadHQ client download folder.
  No directory listing. Request filtering rejects dot-segments. Static files only.
  Do not point this site at a server directory, a plugin folder, or a parent of this folder.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <hiddenSegments>
          <add segment="bin" />
          <add segment=".." />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".jar" />
          <remove fileExtension=".exe" />
          <remove fileExtension=".toml" />
          <remove fileExtension=".mrpack" />
        </fileExtensions>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
